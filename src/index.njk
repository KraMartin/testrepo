---
layout: base.njk
---
<h1>{{ site.title }}</h1>
<p>{{ site.description }}</p>

<h2>Latest posts</h2>
<ul class="post-list">
{%- for post in collections.posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {%- if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
  </li>
{%- endfor %}
</ul>
